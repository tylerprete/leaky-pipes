// Leaky Pipes on Cloudflare: one Worker plus one Durable Object class (a room per game).
// It lives at the repository root so `npx wrangler deploy` works with no arguments, which is
// what Cloudflare's Git-connected builds run by default. Details: cloudflare/README.md
//   npx wrangler dev      run locally at http://localhost:8787
//   npx wrangler deploy   publish to your account
{
  "name": "leaky-pipes",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  // the built game page; the Worker runs first so it can point the page at itself
  "assets": { "directory": "./docs", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  // SQLite-backed storage: the only kind available on the free plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    // strongest computer level allowed. "hard" needs far more CPU per move than the free
    // plan's limit, so keep "normal" unless you are on the paid plan.
    "MAX_LEVEL": "normal",
    "BOT_MS": "900", // pause before a computer moves
    "AWAY_MS": "30000" // a computer covers for an absent player after this long
  }
}
